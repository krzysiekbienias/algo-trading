# Copy this file to .env and adjust for your local TWS / IB Gateway setup.
# .env is gitignored — never commit real credentials.

# --- IBKR TWS / IB Gateway ---
# TWS must be running with API enabled:
#   Edit → Global Configuration → API → Settings → Enable ActiveX and Socket Clients
# Paper trading default port is 7497; live is 7496.
IBKR_HOST=127.0.0.1
IBKR_PORT=7497
IBKR_CLIENT_ID=1

# Harvester pacing (optional; used by dev_main --harvest)
# Pause between reqHistoricalData chunks (ms). Default 12000.
# HARVEST_SLEEP_MS=12000
# Sleep after IB error 162 pacing violation (ms). Default 60000.
# HARVEST_PACING_SLEEP_MS=60000
