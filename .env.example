# Copy this file to .env and fill in your XTB demo credentials.
# .env is gitignored — never commit real credentials.

# XTB demo account number (7 digits, sent to you by email after signup).
XTB_USER_ID=

# Password you set for the demo account (same one used in xStation 5).
XTB_PASSWORD=

# WebSocket endpoint. Use /demo for paper trading, /real for live (DO NOT in dev).
XTB_ENDPOINT=wss://ws.xapi.pro/demo

# Application name reported to XTB during login (any short string).
XTB_APP_NAME=algo-trading-dev

# Default minimum delay between API requests (ms). XTB recommends >= 200 ms.
XTB_THROTTLE_MS=250
